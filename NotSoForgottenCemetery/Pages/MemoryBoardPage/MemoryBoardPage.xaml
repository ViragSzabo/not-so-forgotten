<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Cemetery"
             xmlns:vm="clr-namespace:Cemetery.ViewModels"
             x:Class="Cemetery.MemoryBoardPage"
             x:DataType="vm:MemoryBoardViewModel"
             BackgroundColor="{StaticResource Black}"
             Title="Memory Archive">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24" Spacing="24">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="The Memory Archive"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Tertiary}"
                           HorizontalOptions="Center" />
                    <Label Text="A repository of cherished moments."
                           TextColor="{StaticResource MistGray}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           FontAttributes="Italic"/>
                    <BoxView HeightRequest="1" WidthRequest="120" Color="{StaticResource Tertiary}" HorizontalOptions="Center" Margin="0,8,0,0"/>
                </VerticalStackLayout>

                <CollectionView ItemsSource="{Binding Memories}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:MemoryDb">
                            <Border BackgroundColor="{StaticResource Secondary}"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Surface}"
                                    StrokeShape="RoundRectangle 12">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16">
                                    <VerticalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding Title}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource White}" />
                                        <Label Text="{Binding Date, StringFormat='{0:MMMM d, yyyy}'}"
                                               FontSize="11"
                                               TextColor="{StaticResource MutedGold}" />
                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               TextColor="{StaticResource OffWhite}"
                                               LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center" WidthRequest="90">
                                        <Button Text="Spotify"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MemoryBoardViewModel}}, Path=ListenOnSpotifyCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="{StaticResource White}"
                                                CornerRadius="6"
                                                HeightRequest="32"
                                                FontSize="11" />
                                        <Button Text="YouTube"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MemoryBoardViewModel}}, Path=WatchOnYouTubeCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="{StaticResource White}"
                                                CornerRadius="6"
                                                HeightRequest="32"
                                                FontSize="11" />
                                        <Button Text="Delete"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MemoryBoardViewModel}}, Path=DeleteMemoryCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource CrimsonLake}"
                                                TextColor="{StaticResource White}"
                                                CornerRadius="6"
                                                HeightRequest="32"
                                                FontSize="11" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
